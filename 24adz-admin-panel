<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>24Adz.com | Admin Panel</title>
<style>
:root{--bg:#090909;--panel:#151515;--panel2:#1e1e1e;--line:#343434;--text:#f5f5f5;--muted:#aaa;--orange:#ff8a00;--red:#e74727;--green:#21b573}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font:15px Arial,sans-serif}button,input,select,textarea{font:inherit}button{cursor:pointer;border:0;border-radius:9px;padding:11px 15px;font-weight:700;background:var(--orange);color:#111}button.secondary{background:#333;color:#fff;border:1px solid #555}button.danger{background:#a92d25;color:#fff}button.good{background:#147b50;color:#fff}.hidden{display:none!important}.wrap{max-width:1250px;margin:auto;padding:18px}.top{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;border-bottom:1px solid var(--line);padding:8px 0 18px}.brand{font-size:25px;font-weight:900}.brand span{color:var(--orange)}.muted{color:var(--muted)}.login{max-width:430px;margin:9vh auto;background:var(--panel);border:1px solid var(--line);padding:26px;border-radius:16px}.panel{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:18px;margin-top:16px}.field{display:flex;flex-direction:column;gap:7px;margin:12px 0}.field input,.field select,.field textarea,.apirow input{background:#0d0d0d;border:1px solid #444;color:#fff;padding:12px;border-radius:8px;width:100%}.field textarea{min-height:75px}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.tabs{display:flex;gap:8px;flex-wrap:wrap;margin-top:18px}.tabs button{background:#292929;color:#ddd}.tabs button.active{background:var(--orange);color:#111}.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:15px}.stat{background:var(--panel2);padding:15px;border-radius:10px}.stat b{display:block;font-size:24px;color:var(--orange);margin-top:6px}.ad{display:grid;grid-template-columns:1fr auto;gap:12px;border-bottom:1px solid var(--line);padding:15px 0}.ad:last-child{border:0}.ad h3{margin:0 0 7px}.actions{display:flex;gap:7px;flex-wrap:wrap;align-items:center}.pill{display:inline-block;padding:4px 8px;border-radius:20px;background:#333;color:#ddd;font-size:12px}.msg{margin-top:10px;padding:10px;border-radius:8px;background:#252525;color:#fff;white-space:pre-wrap}.apirow{display:flex;gap:8px;align-items:center;flex-wrap:wrap}.apirow input{flex:1;min-width:230px}.empty{padding:24px;text-align:center;color:var(--muted)}@media(max-width:700px){.grid{grid-template-columns:1fr}.ad{grid-template-columns:1fr}.stats{grid-template-columns:1fr 1fr}.wrap{padding:12px}.login{margin:5vh 12px}}
</style></head>
<body>
<div class="wrap">
<header class="top"><div class="brand">24<span>Adz</span>.com <small class="muted">ADMIN</small></div><div class="actions"><span id="adminLabel" class="muted"></span><button id="logoutBtn" class="secondary hidden" onclick="logout()">Logout</button></div></header>
<section id="loginView" class="login"><h2>Admin Login</h2><p class="muted">Sign in to manage 24Adz listings and categories.</p><div class="field"><label>Admin username</label><input id="username" autocomplete="username" placeholder="Admin username"></div><div class="field"><label>Password</label><input id="password" type="password" autocomplete="current-password" placeholder="Admin password"></div><button style="width:100%" onclick="login()">Login</button><div id="loginMsg" class="msg hidden"></div><div class="field" style="margin-top:20px"><label>API Base URL</label><input id="apiLogin" value="https://api.24adz.com" placeholder="https://api.24adz.com"></div><p class="muted" style="font-size:12px">Set the API URL to your deployed 24Adz Worker domain.</p></section>
<section id="dashboard" class="hidden">
<div class="panel"><div class="apirow"><div style="flex:1"><b>API Connection</b><div id="connection" class="muted">Not checked</div></div><button class="secondary" onclick="checkHealth()">Test API</button></div></div>
<div class="stats"><div class="stat">Pending ads<b id="pendingCount">—</b></div><div class="stat">Approved ads<b id="approvedCount">—</b></div><div class="stat">Rejected ads<b id="rejectedCount">—</b></div></div>
<nav class="tabs"><button class="active" data-tab="ads" onclick="tab('ads',this)">Ads Moderation</button><button data-tab="categories" onclick="tab('categories',this)">Categories</button><button data-tab="subcategories" onclick="tab('subcategories',this)">Subcategories</button><button data-tab="areas" onclick="tab('areas',this)">District Areas</button></nav>
<section id="tab-ads" class="panel"><div class="actions" style="justify-content:space-between"><h2>Manage Ads</h2><div class="actions"><select id="statusFilter" onchange="loadAds()" style="background:#111;color:#fff;border:1px solid #444;padding:10px;border-radius:8px"><option value="pending">Pending</option><option value="approved">Approved</option><option value="rejected">Rejected</option></select><button class="secondary" onclick="loadAds()">Refresh</button></div></div><div id="adsList"><div class="empty">Loading ads…</div></div></section>
<section id="tab-categories" class="panel hidden"><h2>Create Main Category</h2><div class="grid"><div class="field"><label>Category name</label><input id="catName" placeholder="Example: Cars"></div><div class="field"><label>Icon (emoji)</label><input id="catIcon" placeholder="🚗" maxlength="8"></div></div><div class="field"><label>Sort order</label><input id="catSort" type="number" value="10"></div><button onclick="createCategory()">Create Category</button><div id="catMsg" class="msg hidden"></div><h3>Existing categories</h3><div id="categoryList" class="muted">Loading…</div></section>
<section id="tab-subcategories" class="panel hidden"><h2>Create Subcategory</h2><div class="field"><label>Main category</label><select id="subCategory"><option value="">Loading categories…</option></select></div><div class="field"><label>Subcategory name</label><input id="subName" placeholder="Example: SUV"></div><button onclick="createSubcategory()">Create Subcategory</button><div id="subMsg" class="msg hidden"></div><p class="muted">Subcategories are attached to a main category.</p></section>
<section id="tab-areas" class="panel hidden"><h2>Add Area to District</h2><div class="field"><label>District</label><select id="areaDistrict"><option value="">Loading districts…</option></select></div><div class="field"><label>Area name</label><input id="areaName" placeholder="Example: Avinashi"></div><button onclick="createArea()">Add Area</button><div id="areaMsg" class="msg hidden"></div><p class="muted">This adds a new area to the selected district.</p></section>
</section>
</div>
<script>
let API=(localStorage.getItem('24adz_api')||'https://api.24adz.com').replace(/\/$/,''),TOKEN=localStorage.getItem('24adz_admin_token')||'',CATEGORIES=[],DISTRICTS=[];
const $=id=>document.getElementById(id);
$('apiLogin').value=API;
function message(id,text,ok=false){const el=$(id);el.textContent=text;el.classList.remove('hidden');el.style.borderLeft='4px solid '+(ok?'#21b573':'#e74727')}
async function request(path,opts={}){const headers={'Content-Type':'application/json',...(opts.headers||{})};if(TOKEN)headers.Authorization='Bearer '+TOKEN;let r;try{r=await fetch(API+path,{...opts,headers})}catch(e){throw new Error('API connection failed. Check API URL, Worker deployment and CORS settings.')}let data;try{data=await r.json()}catch{throw new Error('API returned an invalid response.')}if(!r.ok||data.ok===false)throw new Error(data.error||'Request failed ('+r.status+')');return data}
async function login(){API=$('apiLogin').value.trim().replace(/\/$/,'');localStorage.setItem('24adz_api',API);try{const d=await request('/api/admin/login',{method:'POST',body:JSON.stringify({username:$('username').value.trim(),password:$('password').value})});TOKEN=d.token;localStorage.setItem('24adz_admin_token',TOKEN);showDashboard()}catch(e){message('loginMsg',e.message)}}
function logout(){TOKEN='';localStorage.removeItem('24adz_admin_token');$('dashboard').classList.add('hidden');$('loginView').classList.remove('hidden');$('logoutBtn').classList.add('hidden');$('adminLabel').textContent=''}
function showDashboard(){$('loginView').classList.add('hidden');$('dashboard').classList.remove('hidden');$('logoutBtn').classList.remove('hidden');$('adminLabel').textContent='Signed in as Admin';checkHealth();loadAds();loadCategories();loadDistricts();loadCounts()}
function tab(name,btn){document.querySelectorAll('[id^="tab-"]').forEach(x=>x.classList.add('hidden'));$('tab-'+name).classList.remove('hidden');document.querySelectorAll('.tabs button').forEach(x=>x.classList.remove('active'));btn.classList.add('active')}
async function checkHealth(){try{const d=await request('/api/health');$('connection').textContent=d.database?'Connected · D1 database OK · R2 '+(d.storage?'available':'not configured'):'API reached but database unavailable'}catch(e){$('connection').textContent=e.message}}
async function loadAds(){const status=$('statusFilter').value;$('adsList').innerHTML='<div class="empty">Loading…</div>';try{const d=await request('/api/admin/ads?status='+encodeURIComponent(status));renderAds(d.ads||[])}catch(e){$('adsList').innerHTML='<div class="msg">'+esc(e.message)+'</div>'}}
function renderAds(ads){if(!ads.length){$('adsList').innerHTML='<div class="empty">No '+esc($('statusFilter').value)+' ads found.</div>';return}$('adsList').innerHTML=ads.map(a=>`<article class="ad"><div><h3>${esc(a.title||'Untitled ad')} ${a.is_vip?'<span class="pill">VIP</span>':''}</h3><div class="muted">${esc(a.category||'')} · ${esc(a.district||'')}${a.area?' · '+esc(a.area):''} · ₹${Number(a.price||0).toLocaleString('en-IN')}</div><p>${esc(a.description||'')}</p><div class="muted">Seller: ${esc(a.contact_name||'')} · ${esc(a.contact_phone||'')} · Created: ${esc(a.created_at||'')}</div>${a.image_key?'<div class="muted">Image: '+esc(a.image_key)+'</div>':''}</div><div class="actions">${a.status==='pending'?`<button class="good" onclick="adAction('${a.id}','approve')">Approve</button><button class="danger" onclick="rejectAd('${a.id}')">Reject</button>`:''}<button class="danger" onclick="adAction('${a.id}','delete')">Delete</button></div></article>`).join('')}
async function adAction(id,action){if(!confirm('Are you sure you want to '+action+' this ad?'))return;try{await request('/api/admin/ads/'+encodeURIComponent(id)+'/'+action,{method:'POST',body:JSON.stringify({})});await loadAds();await loadCounts()}catch(e){alert(e.message)}}
async function rejectAd(id){const reason=prompt('Reason for rejection (optional):','Does not meet listing rules');if(reason===null)return;try{await request('/api/admin/ads/'+encodeURIComponent(id)+'/reject',{method:'POST',body:JSON.stringify({reason})});await loadAds();await loadCounts()}catch(e){alert(e.message)}}
async function loadCounts(){for(const s of ['pending','approved','rejected']){try{const d=await request('/api/admin/ads?status='+s);$(''+s+'Count').textContent=(d.ads||[]).length}catch{$(s+'Count').textContent='—'}}}
async function loadCategories(){try{const d=await request('/api/categories');CATEGORIES=d.categories||[];$('categoryList').innerHTML=CATEGORIES.length?CATEGORIES.map(c=>`<div style="padding:8px;border-bottom:1px solid #333">${esc(c.icon||'📦')} ${esc(c.name)} <span class="muted">(${(c.subcategories||[]).length} subcategories)</span></div>`).join(''):'No categories';$('subCategory').innerHTML='<option value="">Select category</option>'+CATEGORIES.map(c=>`<option value="${c.id}">${esc(c.name)}</option>`).join('')}catch(e){$('categoryList').textContent=e.message}}
async function createCategory(){try{const name=$('catName').value.trim();await request('/api/admin/categories',{method:'POST',body:JSON.stringify({name,icon:$('catIcon').value.trim(),sort_order:Number($('catSort').value)||99})});message('catMsg','Category created successfully.',true);$('catName').value='';$('catIcon').value='';await loadCategories()}catch(e){message('catMsg',e.message)}}
async function createSubcategory(){try{await request('/api/admin/subcategories',{method:'POST',body:JSON.stringify({category_id:Number($('subCategory').value),name:$('subName').value.trim()})});message('subMsg','Subcategory created successfully.',true);$('subName').value='';await loadCategories()}catch(e){message('subMsg',e.message)}}
async function loadDistricts(){try{const d=await request('/api/districts');DISTRICTS=d.districts||[];$('areaDistrict').innerHTML='<option value="">Select district</option>'+DISTRICTS.map(x=>`<option value="${x.id}">${esc(x.name)}</option>`).join('')}catch(e){$('areaDistrict').innerHTML='<option>'+esc(e.message)+'</option>'}}
async function createArea(){try{await request('/api/admin/areas',{method:'POST',body:JSON.stringify({district_id:Number($('areaDistrict').value),name:$('areaName').value.trim()})});message('areaMsg','Area added successfully.',true);$('areaName').value=''}catch(e){message('areaMsg',e.message)}}
function esc(s){return String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
if(TOKEN){showDashboard()}
</script></body></html>
