<script>
'use strict';
const KEY='24adz_admin_prototype_v1';
const DEFAULT_CATEGORIES=['Cars','Bikes','House','Mobiles','Jobs','House Movers'];
const DEFAULT_DISTRICTS=['Ariyalur','Chengalpattu','Chennai','Coimbatore','Cuddalore','Dharmapuri','Dindigul','Erode','Kallakurichi','Kancheepuram','Kanniyakumari','Karur','Krishnagiri','Madurai','Mayiladuthurai','Nagapattinam','Namakkal','Perambalur','Pudukkottai','Ramanathapuram','Ranipet','Salem','Sivaganga','Tenkasi','Thanjavur','Theni','Thoothukudi','Tiruchirappalli','Tirunelveli','Tirupathur','Tiruppur','Tiruvallur','Tiruvannamalai','Tiruvarur','Vellore','Viluppuram','Virudhunagar'];
const seed={categories:DEFAULT_CATEGORIES,districts:DEFAULT_DISTRICTS,areas:{'Tiruppur':['Tiruppur','Avinashi','Palladam','Kangayam','Udumalpet','Dharapuram','Perumanallur','Mangalam'],'Coimbatore':['Coimbatore','Pollachi','Mettupalayam'],'Chennai':['Chennai']},ads:[{id:'demo-1',title:'Demo Car Listing',category:'Cars',district:'Tiruppur',area:'Tiruppur',price:450000,status:'Active',expiry:dateAfter(7),vip:true,description:'Demo listing — replace with a real ad.'},{id:'demo-2',title:'Demo Bike Listing',category:'Bikes',district:'Coimbatore',area:'Pollachi',price:65000,status:'Pending',expiry:dateAfter(3),vip:false,description:'Demo listing for admin preview.'},{id:'demo-3',title:'House for Rent — Demo',category:'House',district:'Chennai',area:'Chennai',price:12000,status:'Expired',expiry:dateAfter(-2),vip:false,description:'Demo expired listing.'}],settings:{siteName:'24Adz.com',siteTagline:'Buy & Sell Across Tamil Nadu',seoTitle:'24Adz.com | Classified Ads Tamil Nadu',seoDescription:'Buy and sell cars, bikes, houses, mobiles, jobs and moving services across Tamil Nadu.',supportEmail:''},audit:[]};
function dateAfter(n){let d=new Date();d.setDate(d.getDate()+n);return d.toISOString().slice(0,10)}
function load(){try{let x=JSON.parse(localStorage.getItem(KEY));return x&&Array.isArray(x.ads)?x:structuredClone(seed)}catch(e){return structuredClone(seed)}}let db=load();
function save(){localStorage.setItem(KEY,JSON.stringify(db));renderAll()}
function esc(s){return String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function toast(s){let e=document.getElementById('toast');e.textContent=s;e.classList.add('show');setTimeout(()=>e.classList.remove('show'),2600)}
function logAction(s){db.audit.unshift({at:new Date().toLocaleString(),action:s});db.audit=db.audit.slice(0,30)}
function showPage(name){document.querySelectorAll('.section').forEach(x=>x.classList.remove('active'));document.getElementById('page-'+name).classList.add('active');document.querySelectorAll('.nav button').forEach(x=>x.classList.toggle('active',x.dataset.page===name));let btn=document.querySelector('.nav button[data-page="'+name+'"]');document.getElementById('topTitle').textContent=btn?btn.textContent.trim():'Dashboard';document.getElementById('sidebar').classList.remove('open');if(name==='ads')renderAds();if(name==='locations')renderLocations();if(name==='categories')renderCategories();if(name==='settings')loadSettings()}
document.querySelectorAll('.nav button').forEach(b=>b.addEventListener('click',()=>showPage(b.dataset.page)));
document.getElementById('mobileMenu').onclick=()=>document.getElementById('sidebar').classList.toggle('open');
function statusOf(a){if(a.status==='Active'&&a.expiry&&a.expiry<dateAfter(0))return 'Expired';return a.status||'Pending'}
function badge(s){return '<span class="badge '+s.toLowerCase()+'">'+esc(s)+'</span>'}
function adRows(items,withActions){if(!items.length)return '<tr><td colspan="'+(withActions?7:5)+'" class="empty">No listings found.</td></tr>';return items.map(a=>'<tr><td><div class="ad-title">'+esc(a.title)+'</div><div class="subline">ID: '+esc(a.id)+(a.vip?' · ⭐ VIP':'')+'</div></td><td>'+esc(a.category)+'</td><td>'+esc(a.area)+', '+esc(a.district)+'</td>'+(withActions?'<td>'+(a.price?'₹'+Number(a.price).toLocaleString('en-IN'):'—')+'</td>':'')+'<td>'+badge(statusOf(a))+'</td><td>'+esc(a.expiry||'—')+'</td>'+(withActions?'<td><div class="actions"><button class="btn-secondary small-btn" onclick="editAd(\''+esc(a.id)+'\')">Edit</button><button class="btn-green small-btn" onclick="setStatus(\''+esc(a.id)+'\',\'Active\')">Approve</button><button class="btn-secondary small-btn" onclick="renewAd(\''+esc(a.id)+'\')">Renew</button><button class="btn-danger small-btn" onclick="deleteAd(\''+esc(a.id)+'\')">Delete</button></div></td>':'')+'</tr>').join('')}
function renderDashboard(){document.getElementById('statTotal').textContent=db.ads.length;document.getElementById('statActive').textContent=db.ads.filter(a=>statusOf(a)==='Active').length;document.getElementById('statPending').textContent=db.ads.filter(a=>statusOf(a)==='Pending').length;document.getElementById('statExpired').textContent=db.ads.filter(a=>statusOf(a)==='Expired').length;document.getElementById('vipCount').textContent=db.ads.filter(a=>a.vip).length;document.getElementById('latestRows').innerHTML=adRows(db.ads.slice().reverse().slice(0,5),false);let counts=db.categories.map(c=>[c,db.ads.filter(a=>a.category===c).length]);let max=Math.max(1,...counts.map(x=>x[1]));document.getElementById('categoryBars').innerHTML=counts.map(([c,n])=>'<div class="bar-row"><span>'+esc(c)+'</span><div class="bar"><i style="width:'+(n/max*100)+'%"></i></div><b>'+n+'</b></div>').join('')}
function renderAds(){let q=(document.getElementById('adSearch').value||'').toLowerCase(),st=document.getElementById('statusFilter').value;let list=db.ads.filter(a=>(!q||[a.title,a.category,a.district,a.area].join(' ').toLowerCase().includes(q))&&(!st||statusOf(a)===st));document.getElementById('adsRows').innerHTML=adRows(list,true)}
document.getElementById('adSearch').addEventListener('input',renderAds);document.getElementById('statusFilter').addEventListener('change',renderAds);
function fillSelect(id,items,selected){let e=document.getElementById(id),old=selected??e.value;e.innerHTML=items.map(x=>'<option value="'+esc(x)+'">'+esc(x)+'</option>').join('');if(items.includes(old))e.value=old}
function openAdForm(id){let a=db.ads.find(x=>x.id===id);document.getElementById('adForm').reset();document.getElementById('editId').value=a?a.id:'';document.getElementById('adModalTitle').textContent=a?'Edit Listing':'Add New Listing';fillSelect('adCategory',db.categories,a?.category||db.categories[0]);fillSelect('adDistrict',db.districts,a?.district||'Tiruppur');document.getElementById('adTitle').value=a?.title||'';document.getElementById('adArea').value=a?.area||'';document.getElementById('adPrice').value=a?.price||'';document.getElementById('adStatus').value=a?.status||'Pending';document.getElementById('adExpiry').value=a?.expiry||dateAfter(7);document.getElementById('adVip').value=a?.vip?'yes':'no';document.getElementById('adDescription').value=a?.description||'';document.getElementById('adModal').classList.remove('hidden')}
function closeAdForm(){document.getElementById('adModal').classList.add('hidden')}
window.openAdForm=openAdForm;window.closeAdForm=closeAdForm;
document.getElementById('adForm').addEventListener('submit',e=>{e.preventDefault();let id=document.getElementById('editId').value;let item={id:id||('ad-'+Date.now()),title:document.getElementById('adTitle').value.trim(),category:document.getElementById('adCategory').value,district:document.getElementById('adDistrict').value,area:document.getElementById('adArea').value.trim(),price:Number(document.getElementById('adPrice').value||0),status:document.getElementById('adStatus').value,expiry:document.getElementById('adExpiry').value,vip:document.getElementById('adVip').value==='yes',description:document.getElementById('adDescription').value.trim()};if(id)db.ads=db.ads.map(a=>a.id===id?item:a);else db.ads.push(item);logAction((id?'Edited':'Added')+' listing: '+item.title);save();closeAdForm();toast('Listing saved in this browser demo.');});
window.editAd=id=>openAdForm(id);window.setStatus=(id,s)=>{let a=db.ads.find(a=>a.id===id);if(!a)return;a.status=s;logAction(s+' listing: '+a.title);save();toast('Status changed in demo.');};window.deleteAd=id=>{let a=db.ads.find(a=>a.id===id);if(!a||!confirm('Delete '+a.title+' from this browser demo?'))return;db.ads=db.ads.filter(a=>a.id!==id);logAction('Deleted listing: '+a.title);save();toast('Deleted from demo storage.');};window.renewAd=id=>{let a=db.ads.find(a=>a.id===id);if(!a)return;a.expiry=dateAfter(7);a.status='Active';logAction('Renewed listing: '+a.title);save();toast('Renewed for 7 days in demo.');};
function renderCategories(){document.getElementById('categoryChips').innerHTML=db.categories.map((c,i)=>'<div class="chip">'+esc(c)+' <button aria-label="Remove '+esc(c)+'" onclick="removeCategory('+i+')">×</button></div>').join('')||'<p class="muted">No categories.</p>'}
window.removeCategory=i=>{let c=db.categories[i];if(db.ads.some(a=>a.category===c)){toast('Cannot remove a category used by ads. Reassign those ads first.');return}if(!confirm('Remove category '+c+'?'))return;db.categories.splice(i,1);logAction('Removed category '+c);save();renderCategories()};document.getElementById('categoryForm').addEventListener('submit',e=>{e.preventDefault();let c=document.getElementById('newCategory').value.trim();if(db.categories.some(x=>x.toLowerCase()===c.toLowerCase()))return toast('Category already exists.');db.categories.push(c);document.getElementById('newCategory').value='';logAction('Added category '+c);save();renderCategories();toast('Category added in demo.')});
function renderLocations(){fillSelect('areaDistrict',db.districts,document.getElementById('areaDistrict').value||'Tiruppur');document.getElementById('districtChips').innerHTML=db.districts.map((d,i)=>'<div class="chip">'+esc(d)+' <button onclick="removeDistrict('+i+')">×</button></div>').join('');renderAreas()}
function renderAreas(){let d=document.getElementById('areaDistrict').value;let a=db.areas[d]||[];document.getElementById('areaChips').innerHTML=a.map((x,i)=>'<div class="chip">'+esc(x)+' <button onclick="removeArea('+i+')">×</button></div>').join('')||'<p class="muted">No areas added for this district yet.</p>'}
document.getElementById('areaDistrict').addEventListener('change',renderAreas);document.getElementById('districtForm').addEventListener('submit',e=>{e.preventDefault();let d=document.getElementById('newDistrict').value.trim();if(db.districts.some(x=>x.toLowerCase()===d.toLowerCase()))return toast('District already exists.');db.districts.push(d);db.areas[d]=db.areas[d]||[];document.getElementById('newDistrict').value='';logAction('Added district '+d);save();renderLocations();toast('District added in demo.')});window.removeDistrict=i=>{let d=db.districts[i];if(db.ads.some(a=>a.district===d))return toast('Cannot remove district used by ads.');if(!confirm('Remove district '+d+'?'))return;db.districts.splice(i,1);delete db.areas[d];logAction('Removed district '+d);save();renderLocations()};document.getElementById('areaForm').addEventListener('submit',e=>{e.preventDefault();let d=document.getElementById('areaDistrict').value,a=document.getElementById('newArea').value.trim();db.areas[d]=db.areas[d]||[];if(db.areas[d].some(x=>x.toLowerCase()===a.toLowerCase()))return toast('Area already exists.');db.areas[d].push(a);document.getElementById('newArea').value='';logAction('Added area '+a+' in '+d);save();renderAreas();toast('Area added in demo.')});window.removeArea=i=>{let d=document.getElementById('areaDistrict').value;db.areas[d].splice(i,1);logAction('Removed area in '+d);save();renderAreas()};
function loadSettings(){Object.entries(db.settings||{}).forEach(([k,v])=>{let id={siteName:'siteName',siteTagline:'siteTagline',seoTitle:'seoTitle',seoDescription:'seoDescription',supportEmail:'supportEmail'}[k],e=document.getElementById(id);if(e)e.value=v||''})}document.getElementById('settingsForm').addEventListener('submit',e=>{e.preventDefault();db.settings={siteName:siteName.value,siteTagline:siteTagline.value,seoTitle:seoTitle.value,seoDescription:seoDescription.value,supportEmail:supportEmail.value};logAction('Saved website settings');save();toast('Settings saved to this browser demo.')});
function renderAudit(){document.getElementById('auditRows').innerHTML=db.audit.length?db.audit.map(x=>'<div style="padding:9px 0;border-bottom:1px solid #292929"><b>'+esc(x.action)+'</b><div style="font-size:12px">'+esc(x.at)+'</div></div>').join(''):'No actions yet.'}
function renderAll(){renderDashboard();renderAds();renderCategories();renderLocations();loadSettings();renderAudit()}
document.getElementById('exportBtn').onclick=()=>{let blob=new Blob([JSON.stringify(db,null,2)],{type:'application/json'}),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download='24adz-admin-demo-export.json';a.click();URL.revokeObjectURL(url);toast('Demo data exported.')};document.getElementById('logoutBtn').onclick=()=>{document.getElementById('appShell').classList.add('hidden');document.getElementById('loginScreen').classList.remove('hidden');document.getElementById('adminPassword').value=''};
function enterDemo(){document.getElementById('loginScreen').classList.add('hidden');document.getElementById('appShell').classList.remove('hidden');renderAll()}document.getElementById('demoEnter').onclick=enterDemo;document.getElementById('loginForm').addEventListener('submit',e=>{e.preventDefault();alert('Secure login is not connected yet. Use “Preview Dashboard (Demo)” to inspect the panel. Before public use, connect Cloudflare Worker authentication.');});
renderAll();
</script></body></html>
